# Copy to android/key.properties (git-ignored) and fill in the upload key.
#
# Create the keystore once:
#   keytool -genkey -v -keystore android/upload-keystore.jks -storetype JKS \
#     -keyalg RSA -keysize 2048 -validity 10000 -alias upload
#
# storeFile is resolved relative to android/app.
storePassword=CHANGE_ME
keyPassword=CHANGE_ME
keyAlias=upload
storeFile=../upload-keystore.jks
