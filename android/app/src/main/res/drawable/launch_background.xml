<?xml version="1.0" encoding="utf-8"?>
<!-- Native launch window, shown until Flutter draws its first frame.
     Matches SplashScreen so the handoff is seamless. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:drawable="@color/brandBackground" />

    <item>
        <bitmap
            android:gravity="center"
            android:src="@drawable/launch_image" />
    </item>
</layer-list>
